# Supply-chain hardening. See "Supply chain" in README.md.

# Do not execute dependency lifecycle scripts (preinstall/install/postinstall).
# This is the primary propagation vector for npm worm attacks. The only package
# in our tree that declares an install script is `fsevents` (optional, macOS
# file-watching) — nothing here needs it.
#
# Note: this also suppresses the root package's own `prepare`/`prepublishOnly`
# hooks during install/publish. We have none; run `npm run build` explicitly
# before publishing.
ignore-scripts=true

# Never write a semver range into package.json. Direct dependencies stay
# pinned to an exact version so upgrades are always an explicit, reviewable diff.
save-exact=true
